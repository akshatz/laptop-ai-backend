{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openwebui": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open WebUI",
      "options": {
        "baseURL": "http://open-webui:8080/api",
        "apiKey": "{env:OPENWEBUI_API_KEY}"
      },
      "models": {
        "llama3.2:latest": { "name": "Llama 3.2 3B (via Open WebUI)" },
        "photo-ai:latest": { "name": "Photo AI (via Open WebUI)" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://ollama:11434/v1" },
      "models": {
        "llama3.2:latest": { "name": "Llama 3.2 3B" }
      }
    },
    "openai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenAI (paid credit)",
      "options": {
        "baseURL": "https://api.openai.com/v1",
        "apiKey": "{env:OPENAI_API_KEY}"
      },
      "models": {
        "gpt-5.4-nano": { "name": "GPT-5.4 nano (OpenAI)" },
        "gpt-5.4-mini": { "name": "GPT-5.4 mini (OpenAI)" }
      }
    },
    "openrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenRouter (paid credit)",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "apiKey": "{env:OPENROUTER_API_KEY}"
      },
      "models": {
        "anthropic/claude-haiku-5.5": { "name": "Claude Haiku 5.5 (OpenRouter)" },
        "anthropic/claude-sonnet-5.5": { "name": "Claude Sonnet 5.5 (OpenRouter)" },
        "openai/gpt-5.4-mini": { "name": "GPT-5.4 mini (OpenRouter)" }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["opencode", "x", "mcp-searxng@2.5.0"],
      "environment": {
        "BUN_BE_BUN": "1",
        "SEARXNG_URL": "http://searxng:8080"
      },
      "enabled": true
    }
  },
  "enabled_providers": ["openwebui", "ollama", "openai", "openrouter"],
  "model": "openwebui/llama3.2:latest",
  "small_model": "openwebui/llama3.2:latest",
  "autoupdate": false,
  "share": "disabled"
}
