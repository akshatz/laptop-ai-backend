{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openwebui": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Open WebUI",
      "options": {
        "baseURL": "http://open-webui:8080/api",
        "apiKey": "{env:OPENWEBUI_API_KEY}"
      },
      "models": {
        "llama3.2:latest": { "name": "Llama 3.2 3B (via Open WebUI)" },
        "photo-ai:latest": { "name": "Photo AI (via Open WebUI)" }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": { "baseURL": "http://ollama:11434/v1" },
      "models": {
        "llama3.2:latest": { "name": "Llama 3.2 3B" }
      }
    }
  },
  "mcp": {
    "searxng": {
      "type": "local",
      "command": ["opencode", "x", "mcp-searxng@2.5.0"],
      "environment": {
        "BUN_BE_BUN": "1",
        "SEARXNG_URL": "http://searxng:8080"
      },
      "enabled": true
    }
  },
  "model": "openwebui/llama3.2:latest",
  "autoupdate": false,
  "share": "disabled"
}
