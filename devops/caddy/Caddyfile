# HTTPS front for Open WebUI, so browsers on the LAN get a secure context
# (plain http://<LAN-IP> isn't one, and Open WebUI's frontend 500s without crypto.randomUUID).
# Certificates come from Caddy's own local CA (kept in the caddy-data volume); trust its root
# once per device — see the comment on the open-webui-proxy service in docker-compose.yml.
{
	# Browsers send no SNI when connecting to an IP address, so tell Caddy which cert to serve.
	default_sni {$OPEN_WEBUI_HOST}
}

https://{$OPEN_WEBUI_HOST}, https://localhost {
	tls internal
	reverse_proxy open-webui:8080
}

# authentik (SSO + TOTP for Open WebUI). Same host, own port, so its OIDC issuer and login pages
# live at https://{$OPEN_WEBUI_HOST}:9443 for browsers and for Open WebUI's server-side calls alike.
https://{$OPEN_WEBUI_HOST}:9443, https://localhost:9443 {
	tls internal
	# authentik flows that finish without a destination (password reset, signing in at :9443
	# directly, logout) end at "/", which would show authentik's app dashboard. Send those to Open
	# WebUI instead; it auto-redirects to SSO and the already-signed-in user lands in the chat.
	# Only the bare "/" — authentik's own pages (/if/user/ settings, /if/admin/, /if/flow/,
	# /application/o/ OIDC, /api/) are untouched.
	@root path /
	redir @root https://{host}:8444/ 302
	reverse_proxy authentik-server:9000
}

# opencode (coding agent web UI), behind authentik sign-in (authentik/blueprints/opencode-sso.yaml,
# group opencode-users). It runs shell commands as root in its container, so allow this port in
# the host firewall only for devices that need it.
https://{$OPEN_WEBUI_HOST}:4443 {
	tls internal
	route {
		# authentik's outpost endpoints (sign-in callback, sign-out) on this same host.
		reverse_proxy /outpost.goauthentik.io/* authentik-server:9000
		forward_auth authentik-server:9000 {
			uri /outpost.goauthentik.io/auth/caddy
			copy_headers X-Authentik-Username X-Authentik-Email
			trusted_proxies private_ranges
		}
		# Signed in: add opencode's own basic auth, so it doesn't ask a second time.
		reverse_proxy opencode:4096 {
			header_up Authorization "Basic {$OPENCODE_BASIC_AUTH}"
		}
	}
}
