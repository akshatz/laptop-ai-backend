# Host path to your Ollama models directory (mounted into the ollama container)
OLLAMA_MODELS_PATH=/usr/share/ollama/.ollama

POSTGRES_USER=dev_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app_data

# Used by open-webui for signing session cookies
WEBUI_SECRET_KEY=changeme

# Used by database/init_db.py when run from the host against the mapped port (5433)
INIT_DB_DATABASE_URL=postgresql+asyncpg://dev_admin:changeme@127.0.0.1:5433/app_data

# AppRole credentials custom-backend uses to authenticate to OpenBao and fetch
# its DB credentials at startup. Generated by openbao/bootstrap.sh - see
# openbao/README.md for the one-time setup steps.
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=

# Gmail SMTP relay used by Passbolt (admin registration/recovery email) and,
# via openbao/bootstrap.sh, by custom-backend (account verification + MFA OTP
# email). PASSBOLT_SMTP_USER must be a full Gmail address; PASSBOLT_SMTP_PASSWORD
# must be an App Password (requires 2FA enabled on the Google account), not your
# normal Gmail password: https://myaccount.google.com/apppasswords
PASSBOLT_SMTP_FROM=passbolt@localhost
PASSBOLT_SMTP_USER=you@gmail.com
PASSBOLT_SMTP_PASSWORD=changeme
