# Host path to your Ollama models directory (mounted into the ollama container)
OLLAMA_MODELS_PATH=/usr/share/ollama/.ollama
# Full ID of the running ollama container (docker inspect -f '{{.Id}}' laptop-ollama). ollama-log-shipper
# reads its Docker log file at /var/lib/docker/containers/<id>/; update this after ollama is recreated.
OLLAMA_CONTAINER_ID=changeme

POSTGRES_USER=dev_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=app_data

# Used by open-webui for signing session cookies
WEBUI_SECRET_KEY=changeme
# Open WebUI's reranker for web search and document results: a SentenceTransformers cross-encoder,
# downloaded from Hugging Face on first start (cached in the open-webui-data volume). Only applies
# while Open WebUI has no saved rag.reranking_model; once an admin saves Settings → Documents, the
# saved value wins (see CLAUDE.md). Copied into OpenBao's apps/default/open-webui by bootstrap.sh.
RAG_RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2

# Used by database/init_db.py when run from the host against the mapped port (5433)
INIT_DB_DATABASE_URL=postgresql+asyncpg://dev_admin:changeme@127.0.0.1:5433/app_data

# AppRole credentials custom-backend uses to authenticate to OpenBao and fetch
# its DB credentials at startup. Generated by openbao/bootstrap.sh - see
# openbao/README.md for the one-time setup steps.
OPENBAO_ROLE_ID=
OPENBAO_SECRET_ID=
# Human OpenBao logins created by openbao/setup-users.sh (userpass): bao-admin manages
# secrets/policies/auth, bao-readonly can only read secrets. Use these instead of the root token.
OPENBAO_ADMIN_PASSWORD=
OPENBAO_READONLY_PASSWORD=

# Rotated in from Milvus's default root/Milvus on first boot by the
# milvus-init-auth service, then used by open-webui to authenticate to Milvus
MILVUS_ROOT_PASSWORD=changeme

# Gmail SMTP relay used by Passbolt (admin registration/recovery email) and,
# via openbao/bootstrap.sh, by custom-backend (account verification + MFA OTP
# email). PASSBOLT_SMTP_USER must be a full Gmail address; PASSBOLT_SMTP_PASSWORD
# must be an App Password (requires 2FA enabled on the Google account), not your
# normal Gmail password: https://myaccount.google.com/apppasswords
PASSBOLT_SMTP_FROM=passbolt@localhost
PASSBOLT_SMTP_USER=you@gmail.com
PASSBOLT_SMTP_PASSWORD=changeme

# Password for the dedicated MariaDB instance passbolt-db uses (Passbolt's
# officially supported/tested database driver)
PASSBOLT_DB_PASSWORD=changeme

# Root user credentials for OpenObserve (O2), created on first successful startup only
# (changing them later doesn't rename the user). Email must be lowercase; the password needs
# 8+ characters with a lowercase letter, an uppercase letter, a digit and a special character.
OPENOBSERVE_ROOT_USER_EMAIL=you@example.com
OPENOBSERVE_ROOT_USER_PASSWORD=changeme

# base64 of "<OPENOBSERVE_ROOT_USER_EMAIL>:<OPENOBSERVE_ROOT_USER_PASSWORD>", used by open-webui to
# send its logs to O2. Regenerate whenever either changes:
#   printf '%s:%s' "$OPENOBSERVE_ROOT_USER_EMAIL" "$OPENOBSERVE_ROOT_USER_PASSWORD" | base64 -w0
OPENOBSERVE_BASIC_AUTH=

# Who gets O2's alert emails (devops/openobserve/alerts.py; sent through the Gmail relay above)
OPENOBSERVE_ALERT_EMAIL=you@example.com

# LAN IP or hostname other devices use to reach Open WebUI over HTTPS (open-webui-proxy, port 8444)
OPEN_WEBUI_HOST=192.168.1.10

# authentik: SSO for Open WebUI with TOTP (Google Authenticator) required.
# Generate the secrets with: openssl rand -base64 60 | tr -d '\n'   (client id: openssl rand -hex 20)
AUTHENTIK_SECRET_KEY=changeme
# Initial authentik admin (`akadmin`), only applied on authentik's first start
AUTHENTIK_BOOTSTRAP_EMAIL=you@example.com
AUTHENTIK_BOOTSTRAP_PASSWORD=changeme
# true/1: everyone must set up an authenticator app (TOTP). false/0: MFA only for users who already have
# one. After changing: recreate authentik-worker and re-apply open-webui-sso.yaml and
# password-recovery.yaml (see the blueprints' comments).
AUTHENTIK_MFA_REQUIRED=true
# OIDC client Open WebUI uses; written into authentik by authentik/blueprints/open-webui-sso.yaml
OPEN_WEBUI_OIDC_CLIENT_ID=changeme
OPEN_WEBUI_OIDC_CLIENT_SECRET=changeme
# OIDC client the OpenBao UI/CLI uses to sign in through authentik; written into authentik by
# authentik/blueprints/openbao-sso.yaml and into OpenBao by openbao/setup-users.sh
OPENBAO_OIDC_CLIENT_ID=openbao
OPENBAO_OIDC_CLIENT_SECRET=changeme
# API token (openssl rand -hex 32) for the open-webui-user-sync service account in authentik
# (authentik/blueprints/open-webui-user-sync.yaml); Open WebUI's authentik User Cleanup Function uses it
# to delete a user's authentik account when an admin deletes them in Open WebUI
OPEN_WEBUI_AUTHENTIK_API_TOKEN=changeme

# SearXNG (Open WebUI web search) secret, e.g. openssl rand -hex 32
SEARXNG_SECRET=changeme
